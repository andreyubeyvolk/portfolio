{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3000", "."],
      "port": 3000
    },
    {
      "name": "nuxt-app-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3001", "nuxt-app/.output/public"],
      "port": 3001
    },
    {
      "name": "nuxt-app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "nuxt-app", "run", "dev", "--", "--port", "3002"],
      "port": 3002
    }
  ]
}
